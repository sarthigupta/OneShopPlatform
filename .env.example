POSTGRES_DB=oneshop
POSTGRES_USER=oneshop
POSTGRES_PASSWORD=oneshop
POSTGRES_PORT=5432

# Local app connections use localhost because the API and worker run outside Docker.
DATABASE_URL=postgresql://oneshop:oneshop@localhost:5432/oneshop
DIRECT_URL=postgresql://oneshop:oneshop@localhost:5432/oneshop
PLATFORM_URL=http://localhost:8080
API_URL=http://localhost:4000
KUBERNETES_NAMESPACE=oneshop
SHOP_IMAGE=oneshop/shop:local
PLATFORM_HOST=localhost
WORKER_POLL_INTERVAL_MS=1000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

